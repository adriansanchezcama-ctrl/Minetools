body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #181818;
    color: white;
    text-align: center;
}

header {
    padding: 40px 20px;
}

h1 {
    font-size: 42px;
    margin-bottom: 10px;
}

.card {
    background: #252525;
    max-width: 500px;
    margin: 20px auto;
    padding: 30px;
    border-radius: 15px;
}

input {
    width: 80%;
    padding: 12px;
    margin: 10px;
    font-size: 16px;
    border-radius: 8px;
    border: none;
}

button {
    padding: 12px 25px;
    font-size: 16px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

button:hover {
    transform: scale(1.05);
}

#resultado {
    font-size: 20px;
    margin-top: 20px;
}

footer {
    margin-top: 50px;
    padding: 20px;
    color: #aaa;
}
